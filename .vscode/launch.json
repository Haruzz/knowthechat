{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend: Vite",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "know-the-chat",
        "order": 1
      }
    },
    {
      "name": "Backend: Python Worker",
      "type": "node-terminal",
      "request": "launch",
      "command": "uv run pywrangler dev",
      "cwd": "${workspaceFolder}/backend",
      "presentation": {
        "group": "know-the-chat",
        "order": 2
      }
    }
  ],
  "compounds": [
    {
      "name": "Full stack: Frontend + Backend",
      "configurations": ["Frontend: Vite", "Backend: Python Worker"],
      "stopAll": true
    }
  ]
}
