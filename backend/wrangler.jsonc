{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "know-the-chat",
  "main": "src/main.py",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["python_workers"],
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOMS", "class_name": "GameRoom" },
      { "name": "ROOM_ADMISSION", "class_name": "RoomAdmission" },
    ],
  },
  "migrations": [
    { "tag": "v1-game-rooms", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2-room-admission", "new_sqlite_classes": ["RoomAdmission"] },
  ],
  "vars": {
    "ROOM_MAX_OPEN": "10",
    "ROOM_PREPARATIONS_PER_DAY": "100",
    "ROOM_MATCHES_PER_DAY": "100",
    "ROOM_CREATIONS_PER_MINUTE": "3",
  },
  "limits": {
    "cpu_ms": 60000,
  },
  "routes": [
    { "pattern": "knowthechat.com", "custom_domain": true },
    { "pattern": "www.knowthechat.com", "custom_domain": true },
  ],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
}
